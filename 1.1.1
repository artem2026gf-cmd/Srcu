-- ===== helpers =====
local function U() return Camera.CFrame end

local function LT()
    local cf = U()
    if not cfg.origin_on then return cf.Position end
    local _, yaw = cf:ToEulerAnglesYXZ()
    return cf.Position + (CFrame.Angles(0, yaw, 0)):VectorToWorldSpace(
        Vector3.new(cfg.origin_x, cfg.origin_y, cfg.origin_z))
end

-- FIX: getSlot через Classes.Character (как в оригинале), fallback на CharacterController
local function getSlotFrom(mod)
    if not mod or type(mod.getInventorySlot) ~= "function" then return nil end
    local ok, up = pcall(debug.getupvalue, mod.getInventorySlot, 1)
    if ok and type(up) == "table" then
        return rawget(up, "CurrentEquipped")
    end
    return nil
end

local function getSlot()
    local ce = getSlotFrom(CharacterClass)
    if ce then return ce end
    return getSlotFrom(CharacterController)
end

local function uT(props)
    if server.hits then return props and props.Penetration or 0 end
    if cfg.wall_limit then return math.huge end
    if cfg.pen_mod then return cfg.pen_value end
    return props and props.Penetration or 0
end

local function minDmg()
    return cfg.min_dmg_override and cfg.min_dmg_override_value or cfg.min_dmg
end

local function isChatting()
    return LocalPlayer:GetAttribute("IsPlayerChatting") == true
        or UserInput:GetFocusedTextBox() ~= nil
end

-- FIX: equip check (как qU в оригинале)
local equipCache = setmetatable({}, { __mode = "k" })
local function isEquipped(gun)
    local t = gun and gun.WeaponEquippedTick
    if type(t) ~= "number" then return true end
    local len = equipCache[gun]
    if not len then
        len = 0.5
        pcall(function()
            local anim = gun.Viewmodel.Animation:getAnimation("Equip")
            if anim and type(anim.Length) == "number" and anim.Length > 0 then
                len = anim.Length
                equipCache[gun] = len
            end
        end)
    end
    return tick() - t > len * 0.925 + 0.03
end

