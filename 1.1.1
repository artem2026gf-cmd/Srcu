-- FIX: revolver secondary fireRate
local function revolverSecondary(gun)
    if not cfg.revolver_alt then return nil end
    local props = gun and gun.Properties
    if not (props and props.ShootingOptions == "Revolver") then return nil end
    local fm = props.FireModes
    return type(fm) == "table" and type(fm.Secondary) == "table" and fm.Secondary or nil
end

local function fireRate(gun)
    local rev = revolverSecondary(gun)
    if rev and type(rev.FireRate) == "number" then return rev.FireRate end
    local fr = type(gun.Properties) == "table" and gun.Properties.FireRate or nil
    if type(fr) == "number" and fr > 0 then return fr end
    return 0.1
end

-- FIX: fire вызывает sendHookRef, а не Remotes.Send напрямую.
-- sendHookRef поднимается после определения sendHook. Так __cf_rage снимается
-- ДО оригинала, сервер получает чистый пакет — не reject'ит.

local sendHookRef = nil
local lastFire = 0
local fireStats = { attempts = 0, ok = 0, fail = 0, lastErr = "" }

local function fire(gun, target)
    local props = gun.Properties
    if not (props and gun.Identifier and target and target.part) then return false end
    if not isEquipped(gun) then return false end

    -- FIX: bulletTP только если нет backtrack-позиции
    local origin = (target.pos and LT()) or bulletTP(target.part) or LT()
    local targetPos = target.pos or predict(target.part)
    local dir = targetPos - origin
    if dir.Magnitude < 0.05 then return false end
    dir = dir.Unit

    local range = props.Range or 500
    local pen = uT(props)
    local bullets = {}

    for i = 1, math.max(props.BulletsPerShot or 1, 1) do
        if server.hits then
            bullets[i] = { Direction = dir, Origin = origin }
        else
            local hits = jT(origin, targetPos, target.part, range, pen, cfg.wallbang)
            if not hits then return false end
            bullets[i] = { Direction = dir, Origin = origin, Hits = kT(origin, hits) }
        end
    end

    gun.ShotSeq = (gun.ShotSeq or 0) + 1
    local packet = {
        IsSniperScoped = gun.IsSniperScoped,
        ShootingHand = gun.ShootingHand,
        Identifier = gun.Identifier,
        Seq = gun.ShotSeq,
        Bullets = bullets,
        ViewTick = server.hits and server.viewTick() or nil,
        __cf_rage = true,
    }

    fireStats.attempts = fireStats.attempts + 1

    -- FIX: вызываем sendHook напрямую — снимает __cf_rage
    local sender = sendHookRef or Remotes.Inventory.ShootWeapon.Send
    local ok, err = pcall(sender, packet)

    if ok then
        fireStats.ok = fireStats.ok + 1
        gun.Rounds = math.max((gun.Rounds or 1) - 1, 0)
        gun.RechargeStartTime = workspace:GetServerTimeNow()
        if target.player and target.dmg and target.dmg > 0 then
            local key = calib.key(gun.Name, ZONE_MAP[target.part.Name], target.walls or 0)
            calib.expect(target.player, key, target.dmg)
        end
    else
        fireStats.fail = fireStats.fail + 1
        fireStats.lastErr = tostring(err)
    end
    return ok
end

-- ===== Send hook =====
local sendRef = Remotes.Inventory.ShootWeapon.Send
local hooked

local function sendHook(packet, ...)
    local function callOrig(...)
        if type(hooked) == "function" then return hooked(...) end
        return sendRef(...)
    end

    if getgenv().rage ~= cfg then return callOrig(packet, ...) end

    if type(packet) == "table" and type(packet.Bullets) == "table" then
        local b1 = packet.Bullets[1]
        if type(b1) == "table" then
            local isServer = (b1.Hits == nil)
            if isServer ~= server.hits then
                server.setHits(isServer)
                if cfg.debug then
                    print("[rage] server_hits=" .. tostring(isServer) .. " (detected)")
                end
            end
        end

        if packet.__cf_rage then
            packet.__cf_rage = nil
            return callOrig(packet, ...)
        end
    end

    return callOrig(packet, ...)
end

sendHookRef = sendHook

hooked = hookfunction(sendRef, sendHook)
print("[rage] Send hooked: " .. type(hooked))

-- ===== Heartbeat loop =====
local lastDiag = 0

local function diagnostic()
    local now = os.clock()
    if now - lastDiag < 2 then return end
    lastDiag = now

    local gun = getSlot()
    local gunInfo = "NO GUN"
    if gun then
        gunInfo = tostring(gun.Identifier or gun.Name or "?")
        if gun.IsReloading then gunInfo = gunInfo .. " (reload)"
        elseif not isEquipped(gun) then gunInfo = gunInfo .. " (equip)"
        elseif (gun.Rounds or 0) <= 0 then gunInfo = gunInfo .. " (empty)"
        end
    end

    print(("[rage] srv=%s gun=%s targets=%d fire=%d/%d fail=%d")
        :format(tostring(server.hits), gunInfo, #scanCache,
            fireStats.ok, fireStats.attempts, fireStats.fail))

    if fireStats.lastErr ~= "" then
        print("[rage] last fire error: " .. fireStats.lastErr)
        fireStats.lastErr = ""
    end
end

local heartbeat = RunService.Heartbeat:Connect(function(dt)
    if not getgenv().rage or not cfg.enabled then return end
    if isChatting() then return end

    trackVelocity(dt)
    trackBacktrack()

    if cfg.debug then diagnostic() end

    local gun = getSlot()
    if not gun or not gun.Bullet or not gun.Properties or gun.IsReloading then return end
    if (gun.Rounds or 0) <= 0 then return end
    if not isEquipped(gun) then return end

    local results = scan(gun)
    if #results == 0 or not cfg.auto_fire then return end

    local now = os.clock()
    if now - lastFire < fireRate(gun) then return end

    local target = results[1]
    local taps = 1
    if cfg.tap_kill and target.dmg > 0 then
        taps = math.clamp(math.ceil(target.hp / target.dmg), 1, cfg.max_taps)
    end
    if cfg.double_tap and taps < 2 then taps = 2 end

    for _ = 1, taps do
        if (gun.Rounds or 0) <= 0 then break end
        if not fire(gun, target) then break end
    end

    lastFire = now
end)

-- ===== API =====
getgenv().rage.stats = function()
    return {
        targets = #scanCache,
        server = server.hits,
        gun = getSlot() ~= nil,
        fire = { ok = fireStats.ok, attempts = fireStats.attempts, fail = fireStats.fail },
    }
end

getgenv().rage.unload = function()
    if heartbeat then pcall(function() heartbeat:Disconnect() end) end
    if restorefunction and type(hooked) == "function" then
        pcall(restorefunction, hooked)
    end
    getgenv().rage = nil
    print("[rage] unloaded")
end

